    "@pawket/sdk": "workspace:*",
    "@pawket/shared": "workspace:*",
    "@react-navigation/native": "^7.1.18",
    "expo": "^54.0.13",
    "expo-linear-gradient": "^15.0.7",
    "expo-router": "^6.0.11",
    "expo-status-bar": "^3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
