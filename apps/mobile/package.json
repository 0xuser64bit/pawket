{
  "name": "@pawket/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android",
    "lint": "eslint app src --ext .ts,.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit",
