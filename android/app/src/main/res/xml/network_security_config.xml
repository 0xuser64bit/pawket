<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Pawket itself is https only. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Loopback only, and needed in release: Mobile Wallet Adapter talks to the
         wallet app over ws://localhost:<port> on this phone. A debug build also
         loads a development server through adb reverse here. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
