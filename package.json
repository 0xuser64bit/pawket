{
  "name": "pawket",
  "version": "0.1.0",
  "private": true,
  "description": "Pawket — a living companion kept in the browser",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:devnet": "PAWKET_DEVNET=1 vitest run src/lib/solana/devnet.test.ts",
    "e2e:coins": "PAWKET_DEVNET=1 vitest run src/server/coins/devnet.test.ts",
    "assets:3d": "node scripts/3d/build.mjs",
    "program:build": "anchor build --arch v2 && mkdir -p src/lib/solana/idl && cp target/idl/pawket.json src/lib/solana/idl/pawket.json",
    "program:test": "pnpm program:build && cargo test -p pawket",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "dependencies": {
    "@meteora-ag/cp-amm-sdk": "1.5.1",
    "@meteora-ag/dynamic-bonding-curve-sdk": "1.5.13",
    "@react-three/fiber": "9.8.1",
    "@solana-mobile/wallet-standard-mobile": "0.6.0",
    "@solana-program/system": "0.14.1",
    "@solana/kit": "8.3.0",
    "@solana/kit-plugin-wallet": "0.20.0",
    "@solana/react": "8.3.0",
    "@solana/web3.js": "1.98.4",
    "bn.js": "5.2.2",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/bn.js": "^5.2.0",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "gltf-validator": "2.0.0-dev.3.10",
    "jsdom": "30.1.0",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
