# Public, client-safe configuration (NEXT_PUBLIC_* is bundled to the browser).
# Safe defaults target devnet so a fresh clone can run without secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Optional WebSocket override. Defaults to wss derived from the RPC URL.
# NEXT_PUBLIC_SOLANA_WS_URL=wss://api.devnet.solana.com
# The Pawket program (devnet). Changes only with a program deploy — see docs/SOLANA.md.
NEXT_PUBLIC_PAWKET_PROGRAM_ID=PawkHvXJKfsUfKs8mgLS7FXbLuNZ43fwEFGkzYdeM74

# Server-only (no NEXT_PUBLIC_ prefix). Nothing here reaches the client bundle.
# Add RPC API keys / privileged config here in the future, e.g.:
# SOLANA_RPC_API_KEY=
