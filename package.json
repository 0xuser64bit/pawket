{
  "name": "pawket",
  "private": true,
  "version": "0.1.0",
  "description": "Pawket — A living on-chain companion game for Solana Mobile.",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "invariants": "node scripts/check-invariants.mjs",
    "idl:sync": "node scripts/sync-idl.mjs",
    "verify": "node scripts/check-invariants.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "clean": "turbo clean && rimraf node_modules .turbo apps/*/node_modules packages/*/node_modules"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "typescript-eslint": "^8.61.0"
  },
  "type": "module"
}
