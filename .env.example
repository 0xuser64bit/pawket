# Public, client-safe configuration (NEXT_PUBLIC_* is bundled to the browser).
# Safe defaults target devnet so a fresh clone can run without secrets.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production on Vercel: NEXT_PUBLIC_APP_URL=https://pawket.world
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# The browser's RPC. "/api/rpc" sends browsers through Pawket's own proxy to
# SOLANA_RPC_URL below (set both): the provider's key stays on the server, and a
# room of players behind one address is not held to the public endpoint's limit.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Server-only (no NEXT_PUBLIC_ prefix). Nothing here reaches the client bundle.
# The RPC the server reads and sends through; may carry a provider key.
# Defaults to NEXT_PUBLIC_SOLANA_RPC_URL. A provider URL with its key goes
# here, never in a NEXT_PUBLIC_ value (the app refuses one with a key).
# SOLANA_RPC_URL=
# The sponsor that pays fees and rent on devnet, as the JSON byte array
# solana-keygen writes (e.g. the contents of .keys/sponsor.json). Unset: a
# linked browser pays its own fees from the Pawket Wallet, and nothing that
# needs rent is sent. It signs Pawket instructions only.
# SPONSOR_KEYPAIR=
