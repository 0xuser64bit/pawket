<?xml version="1.0" encoding="utf-8"?>
<!-- Pawket's mark, drawn from public/favicon.svg at its full size (ink keyline,
     shelf, sun, shine): a paw whose centre pad is a heart. Placed in the
     adaptive icon's 108dp square inside the 66dp safe circle. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.9"
        android:scaleY="0.9"
        android:translateX="25.2"
        android:translateY="23.4">
        <!-- ink: the keyline around each shape, and the shelf below it -->
        <group android:translateY="1.92">
            <path
                android:fillColor="@color/mark_ink"
                android:strokeColor="@color/mark_ink"
                android:strokeLineJoin="round"
                android:strokeWidth="2.82"
                android:pathData="@string/paw_shapes" />
        </group>
        <path
            android:fillColor="@color/mark_ink"
            android:strokeColor="@color/mark_ink"
            android:strokeLineJoin="round"
            android:strokeWidth="2.82"
            android:pathData="@string/paw_shapes" />
        <group android:translateY="1.92">
            <path
                android:fillColor="@color/mark_shelf"
                android:pathData="@string/paw_shapes" />
        </group>
        <path
            android:fillColor="@color/mark_sun"
            android:pathData="@string/paw_shapes" />
        <path
            android:strokeAlpha="0.9"
            android:strokeColor="#FFFFFF"
            android:strokeLineCap="round"
            android:strokeWidth="1.5"
            android:pathData="M10.57,21.28C11.8,21.69 12.9,22.65 13.56,23.87M23.96,10.01C25.26,10.43 26.4,11.57 27.05,13.08M41.82,9.91C43.09,10.17 44.12,11.17 44.63,12.62M55.07,21.08C56.24,21.21 57.16,21.94 57.56,23.04M40.35,33.58C41.96,33.93 43.33,34.99 44.05,36.47" />
    </group>
</vector>
