{
  "expo": {
    "name": "Pawket",
    "slug": "pawket",
    "scheme": "pawket",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.pawket.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#06070F",
          "image": "./assets/brand/pawket-logo.png",
          "dark": {
            "image": "./assets/brand/pawket-logo.png",
            "backgroundColor": "#06070F"
          },
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
